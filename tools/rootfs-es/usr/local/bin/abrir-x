#!/bin/sh
# abrir-x <programa> [argumentos]: espera a que el servidor X este listo y abre el programa en la pantalla X.
# En kng cada programa sale en su propia ventana del escritorio (kng hace de gestor de ventanas, /tmp/.kng-sin-wm).
# Si no (sistema antiguo), arranca matchbox: cada programa ocupa toda la pantalla X.
# Los mensajes del programa (avisos internos, depuracion) van a /var/log/programas.log y no llenan la terminal.
n=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ $n -lt 150 ]; do sleep 0.2; n=$((n+1)); done
export DISPLAY=:0 HOME=${HOME:-/root}
if [ ! -e /tmp/.kng-sin-wm ] && command -v matchbox-window-manager >/dev/null 2>&1 && ! xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id"; then
  matchbox-window-manager -use_titlebar no -use_cursor no >/dev/null 2>&1 &
  n=0; while ! xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id" && [ $n -lt 50 ]; do sleep 0.2; n=$((n+1)); done
fi
mkdir -p /var/log 2>/dev/null
echo "abriendo $1 ... (sus mensajes quedan en /var/log/programas.log)"
echo "=== $(date '+%F %T') $*" >>/var/log/programas.log 2>/dev/null
exec "$@" >>/var/log/programas.log 2>&1 </dev/null
