#!/bin/sh
export DEBIAN_FRONTEND=noninteractive
# actualizar: descarga la lista de programas disponibles (equivale a "apt update")
poner-hora
dpkg --configure -a >/dev/null 2>&1
echo "Actualizando la lista de programas..."
if apt-get update "$@"; then
  echo "Listo. Ahora puedes usar:  instalar <nombre>   |   mejorar   |   buscar <palabra>"
else
  echo "No se pudo actualizar. Revisa la red con:  ping 10.0.2.2   y   dns deb.debian.org"
  exit 1
fi
